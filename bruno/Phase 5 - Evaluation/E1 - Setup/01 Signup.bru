meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{e5Email}}",
    "password": "password123",
    "displayName": "E5 Eval Tester"
  }
}

script:pre-request {
  bru.setVar("e5Email", `e5-eval-${Date.now()}@example.com`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("teamId", res.getBody().team.id);
  }
}
