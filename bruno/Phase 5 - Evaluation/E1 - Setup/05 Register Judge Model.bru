meta {
  name: Register Judge Model
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/gateway/models
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "publicName": "gpt-4o-mini",
    "upstreamModel": "gpt-4o-mini",
    "credentialId": "{{e5ConnectionId}}"
  }
}

script:post-response {
  // Create Experiment and Start Optimize name this model as their `judge_model`.
  // The server has no default judge, so a judge must be registered first: an
  // unregistered name is a 400, "Model 'gpt-4o-mini' is not registered."
}
