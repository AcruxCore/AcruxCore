meta {
  name: Create Dataset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/datasets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "e5eval-manual-set",
    "overall_feedback": "Keep responses short and polite"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("datasetId", res.getBody().id);
  }
}
