meta {
  name: Build Dataset From Feedback
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/datasets/from-feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "e5eval-from-feedback",
    "overall_feedback": "Always third person",
    "feedback_ids": ["{{e5FeedbackId}}"]
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("e5FromFeedbackDatasetId", res.getBody().id);
  }
}
