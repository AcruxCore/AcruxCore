meta {
  name: Render Prompt
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/prompts/{{promptName}}/{{aliasName}}/render
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "variables": {
      "name": "Alice",
      "company": "Acme Corp"
    }
  }
}
