meta {
  name: Commit Version 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tools/{{toolId}}/versions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "description": "v1 - calls httpbin GET",
    "parametersSchema": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]},
    "executor": {
      "type": "http",
      "url": "https://httpbin.org/get",
      "method": "GET",
      "headers": [],
      "query": [{"name": "city", "value": "placeholder"}],
      "argMapping": []
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("toolVersionNumber", res.getBody().versionNumber);
  }
}
