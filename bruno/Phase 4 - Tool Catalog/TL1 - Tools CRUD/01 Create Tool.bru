meta {
  name: Create Tool
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tools
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "get_weather",
    "description": "Fetch current weather for a city."
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("toolId", res.getBody().id);
  }
}
