meta {
  name: Chat Completion
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/gateway/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      { "role": "user", "content": "Say hi in one word." }
    ],
    "max_tokens": 10
  }
}
