{
  "name": "@acruxcoreai/sdk",
  "version": "0.6.7",
  "description": "TypeScript SDK for Acrux Core \u2014 runtime prompt render, gateway chat, tool loops, traces, and feedback",
  "license": "MIT",
  "keywords": [
    "acruxcore",
    "prompt-management",
    "llm",
    "ai-gateway",
    "observability",
    "tracing",
    "sdk"
  ],
  "homepage": "https://acruxcore.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcruxCore/AcruxCore.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "email": "support@acruxcore.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:unit": "vitest run",
    "test:integration": "jest --runInBand --testPathPattern=integration --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=byo.integration --forceExit",
    "test:live": "jest --runInBand --testPathPattern=byo.integration --forceExit",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "lru-cache": "^10.2.2"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "zod": ">=3.25.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
