{
  "name": "@acruxcore/api",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./evaluations/queue": {
      "types": "./dist/src/evaluations/queue/index.d.ts",
      "require": "./dist/src/evaluations/queue/index.js",
      "default": "./dist/src/evaluations/queue/index.js"
    },
    "./evaluations/runs": {
      "types": "./dist/src/evaluations/runs/index.d.ts",
      "require": "./dist/src/evaluations/runs/index.js",
      "default": "./dist/src/evaluations/runs/index.js"
    },
    "./evaluations/runs/processors": {
      "types": "./dist/src/evaluations/runs/processors.d.ts",
      "require": "./dist/src/evaluations/runs/processors.js",
      "default": "./dist/src/evaluations/runs/processors.js"
    },
    "./email": {
      "types": "./dist/src/email/index.d.ts",
      "require": "./dist/src/email/index.js",
      "default": "./dist/src/email/index.js"
    },
    "./notifications/digest": {
      "types": "./dist/src/notifications/digest/index.d.ts",
      "require": "./dist/src/notifications/digest/index.js",
      "default": "./dist/src/notifications/digest/index.js"
    },
    "./traces/retention": {
      "types": "./dist/src/traces/retention/index.d.ts",
      "require": "./dist/src/traces/retention/index.js",
      "default": "./dist/src/traces/retention/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc --project tsconfig.json",
    "postbuild": "mkdir -p dist/src/traces/ingest/otlp/proto && cp -r src/traces/ingest/otlp/proto/. dist/src/traces/ingest/otlp/proto/",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "db:setup": "tsx scripts/db-setup.ts",
    "queues:clear": "tsx scripts/clear-eval-queues.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^10.68.0",
    "@types/pg": "^8.20.0",
    "bcrypt": "^5.1.1",
    "better-auth": "^1.6.25",
    "bullmq": "^5.79.3",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "ioredis": "5.10.1",
    "ipaddr.js": "^1.9.1",
    "isolated-vm": "^5.0.4",
    "jose": "^4.15.9",
    "js-tiktoken": "^1.0.15",
    "nodemailer": "^9.0.3",
    "nunjucks": "^3.2.4",
    "pg": "^8.22.0",
    "protobufjs": "^7.6.5",
    "undici": "^8.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^5.0.2",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
