# Copy to `.env` and fill in only if you need to override a default.
#
# The web app needs NO auth configuration. It calls our own API on its own
# origin and the session is an httpOnly cookie, so there is no client key, no
# token in browser storage, and nothing vendor-specific to set. (This file
# previously carried VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.)

# Optional (parallel-worktree dev): override the dev server port and the
# API proxy target. Unset, they default to 5173 and http://localhost:3001.
# VITE_PORT=5173
# VITE_API_PROXY_TARGET="http://localhost:3001"
