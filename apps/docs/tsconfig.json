// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    // The tests run under `node --experimental-strip-types`, which needs explicit
    // `.ts` import paths. Safe here: this config never emits.
    "allowImportingTsExtensions": true
  },
  "exclude": [".docusaurus", "build", "build-blog", "deploy-blog"]
}
