# AcruxCore — local self-host env file.
#
# Copy this to .env, then run:
#   docker compose -f docker-compose.local.yml up --build
#
# docker-compose.local.yml already has a working default baked in for every
# variable below, so copying this file with no edits is enough to start the
# whole stack. The one line worth changing is GATEWAY_ENCRYPTION_KEY if this
# instance will keep running past a quick trial — regenerate it with:
#   openssl rand -base64 32

# AES-256 key that encrypts stored provider credentials.
GATEWAY_ENCRYPTION_KEY=8+OYoRbp4QqUOmyEVqhXt5xBpkxhYCYGANO6tJVlubI=
